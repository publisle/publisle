{
  "name": "publisle",
  "version": "1.0.0",
  "private": true,
  "description": "Compile semantic documents into static HTML with typed interactive islands.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "cli": "node packages/cli/src/bin.ts",
    "build:examples": "pnpm --filter './examples/*' build",
    "build:playgrounds": "pnpm --filter './examples/playground-*' build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build:examples",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "test:conformance:p0": "node tools/p0-gate.ts",
    "test:conformance:renderer": "node tools/renderer-gate.ts",
    "generate:citations": "node tools/generate-citation-corpus.ts --write && prettier --write packages/contracts/fixtures/citations.json",
    "check:citations": "node tools/generate-citation-corpus.ts",
    "test:python": "python3 -B -m unittest discover -s tools/python -v",
    "test:pdf-service": "node --test deploy/vps/tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:research": "vitest run --config vitest.research.config.ts",
    "test:pdf-ua": "vitest run --config vitest.pdf-ua.config.ts",
    "build:packages": "node tools/build-packages.ts",
    "demo:paper": "node tools/research-paper-demo.ts",
    "docs:check": "node tools/check-docs-links.ts",
    "test:distribution": "node tools/distribution-gate.ts",
    "changeset": "changeset",
    "release:version": "node tools/release.ts version",
    "readmes:check": "node tools/package-readmes.mjs",
    "readmes:write": "node tools/package-readmes.mjs --write"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^10.0.1",
    "@mdx-js/mdx": "3.1.1",
    "@publisle/blocks-core": "workspace:*",
    "@publisle/blocks-technical": "workspace:*",
    "@publisle/cli": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "0.8.3",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "markdownlint-cli2": "0.24.0",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.8",
    "sax": "1.6.1",
    "semver": "^7.8.5",
    "svelte": "5.57.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.3",
    "vitest": "^5.0.1"
  }
}
