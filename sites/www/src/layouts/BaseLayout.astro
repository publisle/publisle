---
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/jetbrains-mono";
import "@publisle/adapter-core/document.css";
import "@publisle/adapter-core/katex.css";
import "../styles/site.css";
import { ClientRouter } from "astro:transitions";
import ThemeToggle from "../components/ThemeToggle.svelte";
import MobileNav from "../components/MobileNav.svelte";

interface Props {
  readonly title: string;
  readonly description?: string;
  readonly path?: string;
  readonly image?: string;
  readonly ogType?: "website" | "article";
  readonly noindex?: boolean;
  readonly jsonLd?: readonly Record<string, unknown>[];
}

const {
  title,
  description = "Turn Markdown into readable web articles, working interactive examples, and print-ready exports.",
  path = "/",
  image = "/og.png",
  ogType = "website",
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL("https://publisle.xyz");
const canonicalUrl = new URL(path, site);
canonicalUrl.pathname = `${canonicalUrl.pathname.replace(/\/+$/u, "")}/`;
const canonical = canonicalUrl.href;
const ogImage = new URL(image, site).href;
const github = "https://github.com/publisle/publisle";

const nav = [
  { href: "/docs/", label: "Docs" },
  { href: "/examples/", label: "Examples" },
  { href: "/playground/", label: "Playground" },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
const ldScripts = jsonLd ?? [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Publisle" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      ldScripts.length > 0 && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@graph": ldScripts,
          })}
        />
      )
    }

    <script is:inline>
      // Default to dark before first paint, preserving a saved preference.
      document.documentElement.dataset.theme = "dark";
      try {
        var stored = localStorage.getItem("publisle-theme");
        if (stored === "light" || stored === "dark") {
          document.documentElement.dataset.theme = stored;
        }
      } catch (error) {}
    </script>
    <script is:inline>
      function mountCopyButtons() {
        var status = document.getElementById("copy-code-status");
        var blocks = document.querySelectorAll("pre");
        for (var index = 0; index < blocks.length; index += 1) {
          var pre = blocks[index];
          if (pre.closest('[aria-label="Compiled preview"]')) continue;
          if (pre.querySelector(":scope > button.copy-code")) continue;
          var button = document.createElement("button");
          button.type = "button";
          button.className = "copy-code";
          button.textContent = "Copy code";
          button.addEventListener("click", function () {
            var host = this.parentElement;
            var control = this;
            if (!host) return;
            var clone = host.cloneNode(true);
            var existing = clone.querySelector("button.copy-code");
            if (existing) existing.remove();
            var text = clone.textContent || "";
            var announce = function (message) {
              if (status) status.textContent = message;
            };
            if (!navigator.clipboard || !navigator.clipboard.writeText) {
              announce("Could not copy code.");
              return;
            }
            navigator.clipboard.writeText(text).then(
              function () {
                announce("Copied code to the clipboard.");
                control.textContent = "Copied";
                window.setTimeout(function () {
                  control.textContent = "Copy code";
                }, 2000);
              },
              function () {
                announce("Could not copy code.");
              },
            );
          });
          pre.insertBefore(button, pre.firstChild);
        }
      }
      document.addEventListener("astro:page-load", mountCopyButtons);
    </script>
    <script>
      document.addEventListener("astro:before-swap", (event) => {
        const theme = document.documentElement.dataset.theme;
        if (theme) event.newDocument.documentElement.dataset.theme = theme;
      });
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-bg"
    >
      Skip to content
    </a>
    <header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
      <div
        class="relative mx-auto flex h-14 w-full max-w-6xl items-center justify-between gap-2 px-4"
      >
        <a
          href="/"
          class="flex items-center gap-2 font-display text-lg font-semibold"
          aria-label="Publisle home"
        >
          <img
            src="/brand/lockup-light.svg"
            alt=""
            class="brand-light h-6 w-auto sm:h-7"
            width="112"
            height="28"
          />
          <img
            src="/brand/lockup-dark.svg"
            alt=""
            aria-hidden="true"
            class="brand-dark h-6 w-auto sm:h-7"
            width="112"
            height="28"
          />
        </a>
        <div class="flex items-center gap-1 sm:gap-2">
          <nav
            aria-label="Main"
            class="hidden items-center gap-1 text-sm sm:flex"
          >
            {
              nav.map((item) =>
                isActive(item.href) ? (
                  <span
                    aria-current="page"
                    class="rounded-md bg-surface px-3 py-1.5 font-medium text-accent"
                  >
                    {item.label}
                  </span>
                ) : (
                  <a
                    href={item.href}
                    class="rounded-md px-3 py-1.5 text-muted transition hover:text-ink"
                  >
                    {item.label}
                  </a>
                ),
              )
            }
            <a
              href={github}
              class="ml-1 rounded-md border border-line px-3 py-1.5 text-muted transition hover:border-accent hover:text-accent"
              rel="me noopener"
            >
              GitHub
            </a>
          </nav>
          <ThemeToggle client:load />
          <MobileNav client:load />
        </div>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div
        class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-4 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
      >
        <p>Copyright (c) 2026 Publisle · MIT License · beta</p>
        <p class="flex gap-4">
          <a href="/docs/" class="hover:text-accent">Docs</a>
          <a href={github + "/issues"} class="hover:text-accent">Issues</a>
          <a href={github + "/releases"} class="hover:text-accent">Releases</a>
        </p>
      </div>
    </footer>
    <div id="copy-code-status" class="sr-only" aria-live="polite"></div>
  </body>
</html>
