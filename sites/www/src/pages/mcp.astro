---
import BaseLayout from "../layouts/BaseLayout.astro";
import McpDemo from "../components/McpDemo.svelte";
import { CLIENT_CONFIG, CURL_EXAMPLE } from "../lib/mcp-demo";

const tools = [
  ["list_blocks", "Block types with default data"],
  ["new_document", "Start a document with metadata"],
  ["add_block", "Insert any block at any position"],
  ["update_block", "Replace one block's content"],
  ["move_block", "Reorder, duplicate or remove blocks"],
  ["import_markdown", "Convert Markdown to a document"],
  ["validate", "Report diagnostics"],
  ["render_html", "The same preview as the playground"],
  ["compile_pdf", "Export a PDF with the Rust compiler"],
];
---

<BaseLayout
  title="MCP · Publisle"
  description="Let an AI assistant draft, edit, preview and export Publisle documents through a stateless MCP endpoint, with PDFs compiled by the Rust compiler."
  path="/mcp/"
  jsonLd={[{ "@type": "WebPage", name: "Publisle MCP server", url: "https://publisle.xyz/mcp/" }]}
>
  <div class="py-10">
    <h1 class="font-display text-4xl font-bold">MCP server</h1>
    <p class="mt-2 max-w-2xl text-muted">
      Publisle speaks the Model Context Protocol, so an assistant can draft a document block by block,
      validate it, preview the HTML and export a PDF. The server holds no state: every call carries the
      whole document. Run a real session below.
    </p>
    <noscript>
      <p class="mt-4 rounded-lg border border-line bg-surface p-4 text-sm">
        The live demo needs JavaScript. The <a class="text-accent hover:underline" href="/docs/guides/mcp/">MCP guide</a>
        explains the tools and how to connect a client.
      </p>
    </noscript>

    <div class="mt-8">
      <McpDemo client:load />
    </div>

    <section class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2" aria-labelledby="mcp-connect">
      <div class="min-w-0">
        <h2 id="mcp-connect" class="font-display text-2xl font-semibold">Connect your own client</h2>
        <p class="mt-2 text-sm text-muted">
          Clients that take a remote URL (Cursor, Claude and others) need only this entry.
          For stdio-only clients, bridge with <code>npx mcp-remote https://api.publisle.xyz/mcp</code>.
        </p>
        <pre class="mt-3 overflow-x-auto rounded-lg border border-line bg-raised p-4 font-mono text-sm"><code>{CLIENT_CONFIG}</code></pre>
        <p class="mt-4 text-sm text-muted">Or call it directly:</p>
        <pre class="mt-2 overflow-x-auto rounded-lg border border-line bg-raised p-4 font-mono text-xs"><code>{CURL_EXAMPLE}</code></pre>
      </div>
      <div class="min-w-0">
        <h2 class="font-display text-2xl font-semibold">What an assistant can do</h2>
        <ul class="mt-3 divide-y divide-line rounded-lg border border-line bg-surface">
          {tools.map(([name, text]) => (
            <li class="flex flex-wrap items-baseline gap-x-3 px-4 py-2 text-sm">
              <code class="font-mono">{name}</code>
              <span class="text-muted">{text}</span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-sm text-muted">
          Read the <a class="text-accent hover:underline" href="/docs/guides/mcp/">full guide</a> for the
          complete tool list, limits and the feasibility notes.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
