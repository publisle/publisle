{
  "name": "@publisle/playground",
  "version": "0.2.4",
  "type": "module",
  "sideEffects": false,
  "svelte": "./src/index.ts",
  "license": "MIT",
  "keywords": [
    "publisle",
    "editor",
    "playground",
    "svelte",
    "blocks"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./BlockEditor.svelte": {
      "svelte": "./src/BlockEditor.svelte",
      "default": "./src/BlockEditor.svelte"
    },
    "./MathEditor.svelte": {
      "svelte": "./src/MathEditor.svelte",
      "default": "./src/MathEditor.svelte"
    },
    "./MathBlockEditor.svelte": {
      "svelte": "./src/MathBlockEditor.svelte",
      "default": "./src/MathBlockEditor.svelte"
    },
    "./JsonField.svelte": {
      "svelte": "./src/JsonField.svelte",
      "default": "./src/JsonField.svelte"
    },
    "./core": "./src/core.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dependencies": {
    "@publisle/blocks-core": "workspace:^",
    "@publisle/core": "workspace:^",
    "@publisle/markdown": "workspace:^",
    "@publisle/schema": "workspace:^",
    "katex": "^0.16.47"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./BlockEditor.svelte": {
        "types": "./dist/BlockEditor.svelte.d.ts",
        "svelte": "./dist/BlockEditor.svelte",
        "default": "./dist/BlockEditor.svelte"
      },
      "./MathEditor.svelte": {
        "types": "./dist/MathEditor.svelte.d.ts",
        "svelte": "./dist/MathEditor.svelte",
        "default": "./dist/MathEditor.svelte"
      },
      "./MathBlockEditor.svelte": {
        "types": "./dist/MathBlockEditor.svelte.d.ts",
        "svelte": "./dist/MathBlockEditor.svelte",
        "default": "./dist/MathBlockEditor.svelte"
      },
      "./JsonField.svelte": {
        "types": "./dist/JsonField.svelte.d.ts",
        "svelte": "./dist/JsonField.svelte",
        "default": "./dist/JsonField.svelte"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "import": "./dist/core.js",
        "default": "./dist/core.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/publisle/publisle.git",
    "directory": "packages/playground"
  },
  "homepage": "https://publisle.xyz"
}
