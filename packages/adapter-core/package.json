{
  "name": "@publisle/adapter-core",
  "version": "0.2.2",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./document.css": "./src/document.css",
    "./katex.css": "./src/katex.css",
    "./island-runtime": "./src/island-runtime.ts",
    "./publication-runtime": "./src/publication-runtime.ts",
    "./vite": "./src/vite.ts",
    "./node": "./src/node.ts",
    "./async": "./src/async.ts"
  },
  "dependencies": {
    "@publisle/core": "workspace:^",
    "@publisle/markdown": "workspace:^",
    "@publisle/schema": "workspace:^",
    "katex": "^0.16.47"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@publisle/blocks-core": "workspace:*",
    "@publisle/blocks-technical": "workspace:*",
    "@types/katex": "^0.16.8",
    "vite": "^8.3.3"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./document.css": "./dist/document.css",
      "./katex.css": "./dist/katex.css",
      "./island-runtime": {
        "types": "./dist/island-runtime.d.ts",
        "import": "./dist/island-runtime.js",
        "default": "./dist/island-runtime.js"
      },
      "./publication-runtime": {
        "types": "./dist/publication-runtime.d.ts",
        "import": "./dist/publication-runtime.js",
        "default": "./dist/publication-runtime.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "import": "./dist/vite.js",
        "default": "./dist/vite.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js",
        "default": "./dist/node.js"
      },
      "./async": {
        "types": "./dist/async.d.ts",
        "import": "./dist/async.js",
        "default": "./dist/async.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "keywords": [
    "publisle",
    "publication",
    "portable-documents",
    "html",
    "structured-documents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/publisle/publisle.git",
    "directory": "packages/adapter-core"
  },
  "homepage": "https://github.com/publisle/publisle#readme"
}
