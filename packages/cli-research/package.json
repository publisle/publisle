{
  "name": "@publisle/cli-research",
  "version": "0.2.3",
  "description": "Optional Publisle Research profile CLI plugin: journal export, bibliography acquisition, and compiler tooling.",
  "license": "MIT",
  "keywords": [
    "publisle",
    "cli",
    "latex",
    "pdf",
    "citations",
    "export"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "peerDependencies": {
    "@publisle/cli": "workspace:^"
  },
  "devDependencies": {
    "@publisle/blocks-core": "workspace:*"
  },
  "dependencies": {
    "@publisle/adapter-core": "workspace:^",
    "@publisle/core": "workspace:^",
    "@publisle/markdown": "workspace:^",
    "@publisle/research": "workspace:^",
    "@publisle/schema": "workspace:^",
    "@publisle/template-acm": "workspace:^",
    "@publisle/template-article": "workspace:^",
    "@publisle/template-elsevier": "workspace:^",
    "@publisle/template-ieee": "workspace:^",
    "@publisle/template-sdk": "workspace:^",
    "@publisle/template-springer": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/publisle/publisle.git",
    "directory": "packages/cli-research"
  },
  "homepage": "https://github.com/publisle/publisle#readme"
}
