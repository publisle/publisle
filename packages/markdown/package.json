{
  "name": "@publisle/markdown",
  "version": "0.1.4",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "license": "MIT",
  "keywords": [
    "markdown",
    "myst",
    "publisle",
    "portable-documents",
