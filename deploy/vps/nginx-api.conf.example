# Example nginx site for api.publisle.xyz when the edge is not Caddy.
# This file is documentation. install.sh does not copy it into place.
# See deploy/vps/README.md. Point proxy_pass at loopback or PDF_BIND, and
# do not publish that address.
#
# The size cap, proxy timeout and JSON error pages live in
# nginx-api-errors.conf so they can be updated without replacing this block
# (and the certificates the operator configured in it). Add the ssl_certificate
# lines for your host, and keep the include.

server {
    listen 443 ssl;
    server_name api.publisle.xyz;

    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    include /etc/nginx/snippets/publisle-api-errors.conf;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
